# --- shared ---
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ipolens
REDIS_URL=redis://localhost:6379

# --- api ---
API_PORT=4000
API_HOST=0.0.0.0
# Bearer token for /v1/admin (the admin panel sends it). Admin routes are off while unset.
ADMIN_API_TOKEN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# PAN vault: KMS key id (never put the raw key in the repo)
KMS_KEY_ID=
PAN_HASH_SECRET=

# --- worker ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
S3_ENDPOINT=
S3_BUCKET=ipolens-docs
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CANARY_TELEGRAM_BOT_TOKEN=
CANARY_TELEGRAM_CHAT_ID=

# --- admin panel (apps/admin) ---
API_URL=http://localhost:4000
# ADMIN_API_TOKEN above is shared with the API.
# HTTP Basic auth for the panel. Required in production.
ADMIN_USER=
ADMIN_PASSWORD=

# --- monitoring ---
SENTRY_DSN=

# --- mobile (Expo exposes EXPO_PUBLIC_* to the app) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# --- web (marketing site, apps/web) ---
# Public address of the site, for link previews and the QR code on /download.
NEXT_PUBLIC_SITE_URL=
# Privacy/grievance contact shown on the site. Required before launch.
NEXT_PUBLIC_CONTACT_EMAIL=
# The app is distributed only from the website, as an APK. Either drop it into apps/web/public/downloads/
# (named ipolens-<version>.apk; size and SHA-256 are computed at build time) or host it elsewhere and set these:
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_APK_VERSION=
NEXT_PUBLIC_APK_SHA256=
