{
  "name": "@ipolens/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ipolens/shared": "workspace:*",
    "bullmq": "^5.45.0",
    "ioredis": "^5.6.0",
    "mongoose": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ipolens/config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.20.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
