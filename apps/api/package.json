{
  "name": "@ipolens/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "dev:memory": "tsx --env-file-if-exists=../../.env src/scripts/dev-memory.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@ipolens/shared": "workspace:*",
    "fastify": "^5.3.0",
    "fastify-type-provider-zod": "^4.0.0",
    "ioredis": "^5.6.0",
    "mongoose": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@ipolens/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.20.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
